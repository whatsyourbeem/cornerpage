{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-homepage-builder.dev/schemas/content.json",
  "title": "MiniHomepageContentJSON",
  "description": "미니홈페이지빌더 스킬의 출력 콘텐츠 JSON 스키마. references/schema.md의 정식 명세.",
  "type": "object",
  "required": ["meta", "blocks"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "#/$defs/Meta" },
    "blocks": { "$ref": "#/$defs/Blocks" }
  },

  "$defs": {

    "Meta": {
      "type": "object",
      "required": [
        "business_name", "industry_category", "axis_a_tone", "axis_b_layout",
        "cta_primary_action", "cta_interaction_mode", "logo_url", "brand_color"
      ],
      "additionalProperties": false,
      "properties": {
        "business_name": { "type": "string", "minLength": 1 },
        "industry_category": { "type": "string", "minLength": 1 },
        "axis_a_tone": { "enum": ["감성형", "신뢰형", "혼합형"] },
        "axis_b_layout": { "enum": ["갤러리우선", "메뉴우선", "해당없음"] },
        "cta_primary_action": { "enum": ["reservation", "call", "direction"] },
        "cta_interaction_mode": { "enum": ["functional", "guided"] },
        "logo_url": { "type": ["string", "null"], "format": "uri" },
        "brand_color": { "type": ["string", "null"], "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },

    "CTAType": { "enum": ["call", "reservation", "direction", "dm"] },

    "CTA": {
      "type": "object",
      "required": ["type", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/CTAType" },
        "label": { "type": "string", "minLength": 1 }
      }
    },

    "Blocks": {
      "type": "object",
      "required": ["topbar", "hero", "trust_strip", "menu", "info", "sticky_cta"],
      "additionalProperties": false,
      "properties": {
        "topbar": { "$ref": "#/$defs/Topbar" },
        "hero": { "$ref": "#/$defs/Hero" },
        "trust_strip": { "$ref": "#/$defs/TrustStrip" },
        "about": { "anyOf": [{ "$ref": "#/$defs/About" }, { "type": "null" }] },
        "menu": { "$ref": "#/$defs/Menu" },
        "gallery": { "anyOf": [{ "$ref": "#/$defs/Gallery" }, { "type": "null" }] },
        "reviews": { "anyOf": [{ "$ref": "#/$defs/Reviews" }, { "type": "null" }] },
        "info": { "$ref": "#/$defs/Info" },
        "sticky_cta": { "$ref": "#/$defs/StickyCta" },
        "how_it_works": { "anyOf": [{ "$ref": "#/$defs/HowItWorks" }, { "type": "null" }] },
        "faq": { "anyOf": [{ "$ref": "#/$defs/Faq" }, { "type": "null" }] }
      }
    },

    "Topbar": {
      "type": "object",
      "required": ["display_name", "action_button"],
      "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "action_button": { "$ref": "#/$defs/CTA" }
      }
    },

    "Hero": {
      "type": "object",
      "required": ["badge", "headline", "tagline", "background_image_url", "cta"],
      "additionalProperties": false,
      "properties": {
        "badge": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "background_image_url": { "type": ["string", "null"], "format": "uri" },
        "cta": { "$ref": "#/$defs/CTA" }
      }
    },

    "TrustStrip": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "About": {
      "type": "object",
      "required": ["body", "signature_quote", "supporting_image_url"],
      "additionalProperties": false,
      "properties": {
        "body": { "type": ["string", "null"] },
        "signature_quote": { "type": ["string", "null"] },
        "supporting_image_url": { "type": ["string", "null"], "format": "uri" }
      }
    },

    "MenuItem": {
      "type": "object",
      "required": ["name", "price", "description", "image_url", "badge"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "price": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "image_url": { "type": ["string", "null"], "format": "uri" },
        "badge": { "type": ["string", "null"] }
      }
    },

    "MenuTier": {
      "type": "object",
      "required": ["label", "price"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "price": { "type": "string", "minLength": 1 }
      }
    },

    "MenuCategory": {
      "type": "object",
      "required": ["category_name", "tiers", "representative_tier_index"],
      "additionalProperties": false,
      "properties": {
        "category_name": { "type": "string", "minLength": 1 },
        "tiers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/MenuTier" } },
        "representative_tier_index": { "type": "integer", "minimum": 0 }
      }
    },

    "Menu": {
      "type": "object",
      "required": ["label", "mode", "full_list_link_enabled"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["item_price", "item_consult", "package_table"] },
        "items": {
          "anyOf": [
            { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/MenuItem" } },
            { "type": "null" }
          ]
        },
        "categories": {
          "anyOf": [
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/MenuCategory" } },
            { "type": "null" }
          ]
        },
        "full_list_link_enabled": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "package_table" } } },
          "then": { "required": ["categories"], "properties": { "items": { "const": null } } },
          "else": { "required": ["items"], "properties": { "categories": { "const": null } } }
        },
        {
          "if": { "properties": { "mode": { "const": "item_consult" } } },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": { "properties": { "price": { "const": null } } }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },

    "Gallery": {
      "type": "object",
      "required": ["images", "more_link_url"],
      "additionalProperties": false,
      "properties": {
        "images": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
        "more_link_url": { "type": ["string", "null"], "format": "uri" }
      }
    },

    "ReviewItem": {
      "type": "object",
      "required": ["body", "rating", "author", "source"],
      "additionalProperties": false,
      "properties": {
        "body": { "type": "string", "minLength": 1 },
        "rating": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "author": { "type": "string", "minLength": 1 },
        "source": { "type": ["string", "null"] }
      }
    },

    "Reviews": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/ReviewItem" } }
      }
    },

    "HoursStructuredEntry": {
      "type": "object",
      "required": ["day", "open", "close", "break", "last_order", "closed"],
      "additionalProperties": false,
      "properties": {
        "day": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
        "open": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$|^24:00$" },
        "close": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$|^24:00$" },
        "break": {
          "anyOf": [
            { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$|^24:00$" } },
            { "type": "null" }
          ]
        },
        "last_order": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$|^24:00$" },
        "closed": { "type": "boolean" }
      }
    },

    "Hours": {
      "type": "object",
      "required": ["type", "structured"],
      "properties": {
        "type": { "enum": ["24h", "structured"] },
        "structured": {
          "anyOf": [
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/HoursStructuredEntry" } },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "24h" } } }, "then": { "properties": { "structured": { "const": null } } } },
        { "if": { "properties": { "type": { "const": "structured" } } }, "then": { "required": ["structured"], "properties": { "structured": { "type": "array", "minItems": 1 } } } }
      ],
      "additionalProperties": false
    },

    "ExternalLink": {
      "type": "object",
      "required": ["platform", "url"],
      "additionalProperties": false,
      "properties": {
        "platform": { "enum": ["instagram", "kakao", "naver_reservation", "blog"] },
        "url": { "type": "string", "format": "uri" }
      }
    },

    "BusinessInfo": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "registered_name": { "type": "string" },
        "ceo_name": { "type": "string" },
        "registration_number": { "type": "string" }
      }
    },

    "Info": {
      "type": "object",
      "required": ["address", "map_coordinates", "hours", "phone", "external_links", "business_info"],
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "minLength": 1 },
        "map_coordinates": {
          "type": "object",
          "required": ["lat", "lng"],
          "additionalProperties": false,
          "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } }
        },
        "hours": { "$ref": "#/$defs/Hours" },
        "phone": { "type": "string", "minLength": 1 },
        "external_links": { "type": "array", "items": { "$ref": "#/$defs/ExternalLink" } },
        "business_info": { "$ref": "#/$defs/BusinessInfo" }
      }
    },

    "StickyCtaButton": {
      "type": "object",
      "required": ["type", "label", "action_value"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/CTAType" },
        "label": { "type": "string", "minLength": 1 },
        "action_value": { "type": "string", "minLength": 1 }
      }
    },

    "StickyCta": {
      "type": "object",
      "required": ["buttons"],
      "additionalProperties": false,
      "properties": {
        "buttons": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/StickyCtaButton" } }
      }
    },

    "HowItWorksStep": {
      "type": "object",
      "required": ["order", "title", "description"],
      "additionalProperties": false,
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },

    "HowItWorks": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "steps": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/HowItWorksStep" } }
      }
    },

    "FaqItem": {
      "type": "object",
      "required": ["question", "answer"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 }
      }
    },

    "Faq": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FaqItem" } }
      }
    }
  }
}
